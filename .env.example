APP_NAME=payconnectoid
HOST=127.0.0.1
PORT=4106
APP_DATA_FILE=app/data.json
APP_DB_FILE=app/data.sqlite
APP_USER=admin
APP_PASS=replace-with-a-long-random-password
APP_ROLE=admin
APP_SECRET=replace-with-a-long-random-signing-secret
AUTH_SALT=payconnectoid-salt
BODY_LIMIT_BYTES=1048576
IDEMPOTENCY_TTL_HOURS=24
WEBHOOK_SIGNING_SECRET_DEFAULT=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
WEBHOOK_RETRY_DELAYS_MS=0,25,100
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_QUEUE_AUTO_START=true
# Optional: comma-separated allowed origins. In development the server defaults to *.
# CORS_ORIGINS=http://127.0.0.1:3000
# Provider-specific webhook secrets (optional)
# WEBHOOK_SIGNING_SECRET_OZOW=
# WEBHOOK_SIGNING_SECRET_PAYFAST=
