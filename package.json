{
  "name": "payconnectoid-core",
  "version": "0.1.0",
  "description": "Open-core payment orchestration server with idempotent payments, provider adapters, webhook delivery queueing, analytics, and MCP access.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LehroSolutions/payconnectiod.git"
  },
  "homepage": "https://github.com/LehroSolutions/payconnectiod#readme",
  "bugs": {
    "url": "https://github.com/LehroSolutions/payconnectiod/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "app/",
    "scripts/",
    "openapi.yaml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "COMMERCIAL.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  },
  "keywords": [
    "payments",
    "africa",
    "open-core",
    "mcp",
    "webhooks",
    "analytics"
  ],
  "scripts": {
    "test": "bun --test tests/*.test.js",
    "start": "bun app/server.js",
    "sdk:generate": "bun scripts/generate-sdks.js",
    "mcp:start": "bun src/mcp/server.js",
    "package:manager": "bun --version",
    "install:js": "bun install",
    "docs:build": "node scripts/docs.mjs build",
    "docs:check": "node scripts/docs.mjs check",
    "format": "prettier --write \"{src,app,tests,scripts}/**/*.js\" \"*.{json,md,yml,yaml}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"{src,app,tests,scripts}/**/*.js\" \"*.{json,md,yml,yaml}\" \".github/workflows/*.yml\""
  },
  "author": "Lehro Solutions",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
